# Copy to .env.local and fill in. .env.local is gitignored; this file is committed.
#
# Only VITE_-prefixed variables reach the browser bundle. That is deliberate:
# it makes it structurally impossible to leak a server secret through Vite,
# because anything without the prefix is simply not exposed.
#
# NEVER add the service_role key here or anywhere under app/. It bypasses every
# RLS policy in the database. The anon key below is public by design.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# ── Development only ─────────────────────────────────────────────────────────
# Signs the app in automatically as a test user and skips the sign-in screen,
# so every role can be walked through with ?as=coordinator, ?as=data_entry,
# ?as=enumerator, ?as=partner_viewer or ?as=participant.
#
# It only takes effect when the dev server is running (import.meta.env.DEV), and
# `npm run build` FAILS while it is true. Leave it false unless you are
# demoing. Never put it in .env.production.
VITE_AUTH_BYPASS=false
